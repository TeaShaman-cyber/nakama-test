{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pages: test",
      "type": "shell",
      "command": "python -m unittest discover -s blogsite/tests -v",
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Pages: lint",
      "type": "shell",
      "command": "ruff check blogsite",
      "problemMatcher": ["$ruff"]
    },
    {
      "label": "Pages: format-check",
      "type": "shell",
      "command": "ruff format --check blogsite",
      "problemMatcher": []
    },
    {
      "label": "Pages: build",
      "type": "shell",
      "command": "python -m blogsite.build --repo-root . --output public --base-path /nakama-test/",
      "problemMatcher": []
    },
    {
      "label": "Pages: verify",
      "type": "shell",
      "command": "node tools/pages_task.mjs verify",
      "problemMatcher": []
    },
    {
      "label": "Pages: publish",
      "type": "shell",
      "command": "node tools/pages_task.mjs publish",
      "problemMatcher": []
    },
    {
      "label": "Pages: status",
      "type": "shell",
      "command": "node tools/pages_task.mjs status",
      "problemMatcher": []
    }
  ]
}
